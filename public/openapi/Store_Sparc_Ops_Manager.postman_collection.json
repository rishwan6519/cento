                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "description": "Called by Store Manager: returns all store tasks including confidential manager_only items."
          },
          "response": []
