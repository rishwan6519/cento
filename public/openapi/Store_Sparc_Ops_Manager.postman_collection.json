    {
      "name": "5. Roster Planning & Publishing (GAP-SM-007, GAP-SM-008)",
      "item": [
        {
          "name": "Get Week Plan & Coverage Gaps",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/roster?week_start={{weekStart}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "roster"
              ],
              "query": [
                {
                  "key": "week_start",
                  "value": "{{weekStart}}"
                }
              ]
            },
            "description": "Fetches full planning grid: draft vs published shifts, editable flag, locked reason, and non-blocking coverage gaps."
          },
          "response": []
        },
        {
          "name": "Assign / Stage Shifts (Draft Mode)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"week_start\": \"{{weekStart}}\",\n  \"user_id\": \"string\",\n  \"shifts\": [\n    {\n      \"date\": \"YYYY-MM-DD\",\n      \"start_minutes\": 540,\n      \"end_minutes\": 1020\n    }\n  ],\n  \"client_timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/roster/shifts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "roster",
                "shifts"
              ]
            },
            "description": "Stages shift assignments as draft. Server rejects assignments on unavailable days (409) or outside trading hours (409)."
          },
          "response": []
        },
        {
          "name": "Publish Week Roster",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"week_start\": \"{{weekStart}}\",\n  \"client_timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/roster/publish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "roster",
                "publish"
              ]
            },
            "description": "Atomically promotes draft shifts to published. Staff devices immediately receive roster_published alert."
          },
          "response": []
        }
      ]
    },
    {
