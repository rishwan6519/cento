    {
      "name": "7. Store Announcements & WhatsApp (GAP-SM-010)",
      "item": [
        {
          "name": "Get Announcement Board & Templates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
