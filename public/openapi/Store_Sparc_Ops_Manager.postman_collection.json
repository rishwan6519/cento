            "url": {
              "raw": "{{baseUrl}}/store/announcements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "announcements"
              ]
            },
            "description": "Returns WhatsApp group link, quick templates, scheduled posts, and historical broadcast log."
          },
          "response": []
        },
        {
          "name": "Send Now or Schedule Announcement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"string\",\n  \"scheduled_for\": null,\n  \"client_timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/announcements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "announcements"
              ]
            },
            "description": "Dispatches to WhatsApp group & raises store_announcement staff alert. Max 14 days future schedule."
          },
          "response": []
        },
        {
          "name": "Cancel Scheduled Announcement",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
