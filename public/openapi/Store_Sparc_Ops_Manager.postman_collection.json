{
  "info": {
    "_postman_id": "a9f3b221-8c65-46b3-91b2-manager01sparc",
    "name": "Store Sparc Ops - Store Manager API Collection",
    "description": "Dedicated Postman collection for Store Manager & Central Admin operations (GAP-SM-002 through GAP-SM-011). Covers real-time dashboard metrics, approvals queue, dual-state roster planning, task management, WhatsApp announcements, screen diagnostics, and store policies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://iot-test.metizstoresparc.com/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "storeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "managerUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "weekStart",
      "value": "YYYY-MM-DD",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication & Identity (Manager)",
      "item": [
        {
          "name": "Store Manager Login (Acquire Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.token) pm.collectionVariables.set(\"token\", data.token);",
                  "    if (data.user_id) pm.collectionVariables.set(\"managerUserId\", data.user_id);",
                  "    if (data.store && data.store.id) pm.collectionVariables.set(\"storeId\", data.store.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"string\",\n  \"password\": \"string\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates Store Manager user, auto-populating managerUserId, token, and storeId."
          },
          "response": []
        },
        {
          "name": "Resolve Manager Identity (GAP-API-001)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resolve"
              ]
            },
            "description": "Resolves Manager role, administrative claim scopes, and store assignments."
          },
          "response": []
        },
        {
          "name": "Sign Out Session (GAP-API-001)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_token\": \"string\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Terminates manager session and invalidates active JWT."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Store Dashboard (GAP-SM-002, GAP-SM-004)",
      "item": [
        {
          "name": "Get Store Dashboard (Live Metrics & Lateness)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "dashboard"
              ]
            },
            "description": "Returns as_of timestamp, sales (is_sample: true, comparison), attendance (checked_in, rostered, awaited staff with LATE vs EXPECTED_SOON flags, manual check-ins), approvals, next week roster status, tasks, and screen status."
          },
          "response": []
        },
        {
          "name": "Central Admin - Inspect Store Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Central Admin"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/dashboard?store_id={{storeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "dashboard"
              ],
              "query": [
                {
                  "key": "store_id",
                  "value": "{{storeId}}"
                }
              ]
            },
            "description": "Single Source of Truth inspection: Central Admin token querying dashboard with store_id query param."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Approvals Queue & Decisions (GAP-SM-003, GAP-SM-004, GAP-SM-005)",
      "item": [
        {
          "name": "List Approvals Queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/approvals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "approvals"
              ]
            },
            "description": "Returns pending & decided items across shift swaps, attendance corrections, and manual check-ins with compliance flags and permissible decline reasons."
          },
          "response": []
        },
        {
          "name": "Approve Shift Swap or Attendance Correction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": true,\n  \"reason\": null,\n  \"client_timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/approvals/:id/decide",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "approvals",
                ":id",
                "decide"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "description": "Approves a pending swap or correction. Manager does not select replacement; server resolves coverage."
          },
          "response": []
        },
        {
          "name": "Decline with Item's Own Decline Reason",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": false,\n  \"reason\": \"Would leave station under-skilled\",\n  \"client_timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/approvals/:id/decide",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "approvals",
                ":id",
                "decide"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "description": "Declines request. Reason MUST match one of the item's own decline_reasons, else rejected with 422."
          },
          "response": []
        },
        {
          "name": "Confirm or Decline Manual Check-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{managerUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Store Manager"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirm\": true,\n  \"reason\": null,\n  \"client_timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/approvals/:id/decide",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "store",
                "approvals",
                ":id",
                "decide"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "description": "Settles manual punch request. On confirmation, server creates actual staff attendance punch."
          },
          "response": []
        }
      ]
    },
