            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_token\": \"string\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/devices/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                "token"
              ]
            },
            "description": "Removes device token on sign-out to prevent notifications delivering to logged-out devices."
          },
          "response": []
        }
