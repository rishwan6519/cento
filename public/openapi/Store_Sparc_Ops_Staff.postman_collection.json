              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attendance",
                "today"
              ]
            },
            "description": "Returns server verdict for today's rostered shift, punch records, geofence check, and can_check_in / can_check_out flags."
          },
          "response": []
        },
        {
          "name": "Check-in with GPS Location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
