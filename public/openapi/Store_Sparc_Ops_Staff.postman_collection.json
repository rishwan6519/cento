              },
              {
                "key": "x-user-role",
                "value": "Staff"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 0,\n  \"lng\": 0,\n  \"accuracy_m\": 5,\n  \"client_timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/check-out",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attendance",
                "check-out"
              ]
            },
            "description": "Records end-of-shift punch, calculating shift worked duration on the server."
          },
          "response": []
        }
      ]
    },
