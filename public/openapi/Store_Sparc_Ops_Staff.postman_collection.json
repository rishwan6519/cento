{
  "info": {
    "_postman_id": "c8e4a112-9b76-47c4-82a1-staff001sparc",
    "name": "Store Sparc Ops - Staff API Collection",
    "description": "Dedicated Postman collection for Store Staff mobile operations (GAP-API-001 through GAP-API-014). Contains strict request field schemas, authentication tokens, idempotency headers, and empty response templates for live server testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://iot-test.metizstoresparc.com/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "storeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "staffUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "weekStart",
      "value": "YYYY-MM-DD",
      "type": "string"
    },
    {
      "key": "challengeId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication & Identity (Staff)",
      "item": [
        {
          "name": "Staff Login (Acquire Bearer Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.token) pm.collectionVariables.set(\"token\", data.token);",
                  "    if (data.user_id) pm.collectionVariables.set(\"staffUserId\", data.user_id);",
                  "    if (data.store && data.store.id) pm.collectionVariables.set(\"storeId\", data.store.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"string\",\n  \"password\": \"string\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates a staff member, returning a JWT token with Staff claims. Test script auto-populates collection variables."
          },
          "response": []
        },
        {
          "name": "Resolve Caller Identity (GAP-API-001)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{staffUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "Staff"
              },
              {
                "key": "x-store-id",
                "value": "{{storeId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resolve"
              ]
            },
            "description": "Resolves staff profile, assigned store, roles, and UI feature permissions."
          },
          "response": []
        },
        {
          "name": "Start MFA Challenge (GAP-API-001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.challenge_id) pm.collectionVariables.set(\"challengeId\", data.challenge_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{staffUserId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{staffUserId}}\",\n  \"method\": \"sms\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/mfa/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "mfa",
                "start"
              ]
            },
            "description": "Initiates SMS one-time passcode MFA verification for mobile staff."
          },
          "response": []
        },
        {
          "name": "Verify MFA Code (GAP-API-001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.token) pm.collectionVariables.set(\"token\", data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenge_id\": \"{{challengeId}}\",\n  \"code\": \"string\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/mfa/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "mfa",
                "verify"
              ]
            },
            "description": "Verifies the 6-digit MFA OTP and issues full session JWT."
          },
          "response": []
        },
        {
          "name": "Sign Out Session (GAP-API-001)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{staffUserId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_token\": \"string\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Invalidates staff session and unregisters mobile push notifications."
          },
          "response": []
        }
      ]
    },
    {
