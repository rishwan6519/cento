            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 0,\n  \"lng\": 0,\n  \"accuracy_m\": 5,\n  \"client_timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/check-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attendance",
                "check-in"
              ]
