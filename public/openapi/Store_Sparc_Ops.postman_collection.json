{
  "info": {
    "_postman_id": "7b8e5a12-4c22-4d91-9e12-3c8f8b091e32",
    "name": "Store Sparc Ops API (Clean Formats)",
    "description": "Standard Postman collection with request field schemas and empty response templates for live server testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      
      "key": "baseUrl",
      "value": "https://iot-test.metizstoresparc.com/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "storeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "staffUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "managerUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "weekStart",
      "value": "YYYY-MM-DD",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication & Config",
      "item": [
        {
          "name": "Staff / Manager Login (Acquire Auth Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set(\"token\", data.token);",
                  "    }",
                  "    if (data.user_id) {",
                  "        pm.collectionVariables.set(\"staffUserId\", data.user_id);",
                  "    }",
                  "    if (data.store && data.store.id) {",
                  "        pm.collectionVariables.set(\"storeId\", data.store.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"string\",\n  \"password\": \"string\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates a Staff or Store Manager user with username and password, returning a JWT Bearer token. On success, the Postman test script automatically stores the token, staffUserId, and storeId into collection variables."
          },
          "response": []
        },
        {
          "name": "Resolve Caller Identity (GAP-API-001)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-user-id", "value": "{{staffUserId}}" },
              { "key": "x-user-role", "value": "Staff" },
              { "key": "x-store-id", "value": "{{storeId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/resolve",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "resolve"]
            }
          },
          "response": []
        },
        {
          "name": "Start MFA Challenge (GAP-API-001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.challenge_id) {",
                  "        pm.collectionVariables.set(\"challengeId\", data.challenge_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id", "value": "{{staffUserId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"string\",\n  \"method\": \"sms\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/mfa/start",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "mfa", "start"]
            },
            "description": "Initiates an MFA verification challenge, returning challenge_id, code_length, and masked destination_hint (e.g. phone number)."
          },
          "response": []
        },
        {
          "name": "Verify MFA Code (GAP-API-001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set(\"token\", data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenge_id\": \"string\",\n  \"code\": \"string\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/mfa/verify",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "mfa", "verify"]
            },
            "description": "Verifies the 6-digit MFA challenge code. On success, issues a full session JWT token."
          },
          "response": []
        },
        {
          "name": "Sign Out Session (GAP-API-001)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id", "value": "{{staffUserId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_token\": \"string\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/sign-out",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sign-out"]
            },
            "description": "Ends the user session server-side and removes push notifications device registration."
          },
          "response": []
        },
        {
          "name": "Get Store Configuration (GAP-API-014)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-user-id", "value": "{{staffUserId}}" },
              { "key": "x-user-role", "value": "Staff" },
              { "key": "x-store-id", "value": "{{storeId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/store/config",
              "host": ["{{baseUrl}}"],
              "path": ["store", "config"]
            }
          },
          "response": []
        },
        {
          "name": "Update Store Configuration & Geofence (Manager / Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id", "value": "{{managerUserId}}" },
              { "key": "x-user-role", "value": "Store Manager" },
              { "key": "x-store-id", "value": "{{storeId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 0.0,\n  \"longitude\": 0.0,\n  \"geofence_radius\": 0,\n  \"whatsapp_group_link\": \"string\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/store/config",
              "host": ["{{baseUrl}}"],
              "path": ["store", "config"]
            },
            "description": "Updates the store physical coordinates (latitude & longitude), geofence radius in metres, and WhatsApp group link. Allowed for Store Manager or Central Admin."
          },
          "response": []
        }
      ]
    },
